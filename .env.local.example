# ── SUPABASE ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── CRON (openssl rand -hex 32) ───────────────────────────
CRON_SECRET=replace_me_dev_only

# ── SECURITY (server-only, never exposed to client) ───────
# openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace_me_32_bytes_base64
# openssl rand -hex 32
AUDIT_SIGNING_SECRET=replace_me_32_bytes_hex

# ── RATE LIMIT (Upstash Redis REST) ──────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── EMAIL ─────────────────────────────────────────────────
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=no-reply@nukeapi.com
SUPPORT_TO_EMAIL=team@nukeapi.com

# ── DODO PAYMENTS ─────────────────────────────────────────
# Test-mode base URL: https://test.dodopayments.com
# Live-mode base URL: https://live.dodopayments.com
DODO_PAYMENTS_API_KEY=your_dodo_api_key
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/settings/billing
DODO_PRODUCT_STARTUP_MONTHLY=prod_xxx
DODO_PRODUCT_STARTUP_YEARLY=prod_xxx
DODO_PRODUCT_BUSINESS_MONTHLY=prod_xxx
DODO_PRODUCT_BUSINESS_YEARLY=prod_xxx
DODO_PRODUCT_ENTERPRISE_MONTHLY=prod_xxx
DODO_PRODUCT_ENTERPRISE_YEARLY=prod_xxx

# ── OWNER/ADMIN (email-allowlisted internal page) ─────────
OWNER_EMAILS=you@example.com

# ── DEBUG ENDPOINT (opt-in, FAILS CLOSED) ─────────────────
ENABLE_DEBUG_ENDPOINT=false

# ── PUBLIC APP URL ────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
